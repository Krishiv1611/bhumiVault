# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/bhumivault"

# JWT Secret
JWT_SECRET="your-secure-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Blockchain RPC and Contract
RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Node Signer Private Keys (For authorized relayer & backend actions)
ADMIN_PRIVATE_KEY=""
REGISTRAR_PRIVATE_KEY=""
REVENUE_PRIVATE_KEY=""
BANK_PRIVATE_KEY=""
JUDICIARY_PRIVATE_KEY=""

# File Upload Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Startup Sync
AUTO_SYNC_ON_STARTUP=false
